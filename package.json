{
  "name": "dsh-plan-board",
  "version": "0.1.0",
  "description": "四分区计划看板：长期 / 中期 / 短期 / 预想 / agent 建议，右栏常驻，一个项目一份 JSON。",
  "license": "MIT",
  "author": "LTea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LTeax/dsh-plan-board.git"
  },
  "homepage": "https://github.com/LTeax/dsh-plan-board#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plan",
    "todo",
    "sidebar"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
